# LeadOrbit environment example. Copy to .env for local development.
# NEVER commit a real .env or real secrets.

# --- Application ---
PORT=8080
API_PREFIX=/api/v1

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadorbit
DB_USERNAME=leadorbit
DB_PASSWORD=leadorbit
DB_POOL_MAX=20

# --- Security / JWT (override with strong random values) ---
JWT_ACCESS_SECRET=change-me-access-secret-please-override-in-env-1234567890
JWT_ACCESS_EXPIRY=PT15M
JWT_REFRESH_SECRET=change-me-refresh-secret-please-override-in-env-1234567890
JWT_REFRESH_EXPIRY=P7D
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Secure one-time bootstrap super admin ---
# The account is created at first startup only; remove or blank these after seeding.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator

# --- Mail (Mailpit for local dev) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

# --- Storage / billing ---
STORAGE_BASE_PATH=./uploads
BILLING_ZONE_ID=Asia/Kolkata
